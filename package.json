{
  "name": "library-template",
  "version": "0.1.1",
  "description": "A template enumeratio library: figurate numbers, written in Epsil.",
  "license": "WTFPL",
  "keywords": [
    "enumeratio-library"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reference/*": "./reference/*"
  },
  "peerDependencies": {
    "@cortex-js/compute-engine": "*"
  },
  "enumeratio": {
    "namespace": "enumeratio",
    "index": "./reference/index.json",
    "system": "0.x",
    "mappings": [
      "wolfram",
      "oeis",
      "wikipedia"
    ]
  }
}
